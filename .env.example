# ─────────────────────────────────────────────
#  Sales CRM — Environment Variable Reference
# ─────────────────────────────────────────────
#  Copy this file to .env and fill in your values.
#  Never commit the real .env file.

# ── Required ──────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://crm_user:yourpassword@localhost:5432/salescrm

# Secret used to sign JWT tokens. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-secret

# ── API Server ────────────────────────────────

# Port the Express API listens on
PORT=8080

# Set to "production" for production deployments
NODE_ENV=production

# ── Frontend Build ────────────────────────────
# Used at BUILD TIME by Vite (not at runtime).
# Set to "/" if the app is served from the domain root.
# Set to "/crm/" if served under a sub-path.
BASE_PATH=/

# ── SMTP (Optional) ──────────────────────────
# If not set, follow-up emails are logged to console instead of sent.
# These can also be configured inside the app's Setup Wizard or System Config.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-app-password
